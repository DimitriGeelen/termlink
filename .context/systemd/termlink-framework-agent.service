# TermLink Framework Agent — persistent named session for cross-host framework operations
# Source of truth: /opt/termlink/.context/systemd/termlink-framework-agent.service (git-tracked)
# Installed to:    /etc/systemd/system/termlink-framework-agent.service (copy)
# Install with:    sudo .context/systemd/install.sh
#
# Provides a shell-backed, discoverable session that other agents on the ring20 LAN
# can target via `termlink agent ask`, `termlink remote exec`, or `termlink remote push`.
# Handles: fw pickup process, fw audit, fw task list, and general framework operations.

# PER-AGENT IDENTITY (T-2838 item 1 / T-2291 / T-1700)
# ----------------------------------------------------
# --identity-key gives this session its OWN ed25519 keypair instead of the
# host-shared $HOME/.termlink/identity.key. Without it every co-resident agent
# signs as the same fingerprint, so `channel ack-status` returns ONE row for the
# whole host and attribution falls back to `from_project` / `_from` metadata --
# which canonical_sign_bytes does NOT cover, and is therefore forgeable.
#
# This agent holds the `pickup` role and posts to framework:pickup and
# agent-chat-arc, so it is the one whose attribution matters most.
#
# The key is provisioned OUT-OF-BAND (this unit only reads it):
#   TERMLINK_AGENT_ID=framework-agent-systemd termlink identity show --resolve
# creating /root/.termlink/identities/framework-agent-systemd.key chmod 600.
#
# Rollback: drop the --identity-key line, re-run .context/systemd/install.sh.
#
[Unit]
Description=TermLink Framework Agent — persistent shell session (role: framework)
After=termlink-hub.service
Wants=termlink-hub.service

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/opt/termlink

Environment=TERMLINK_RUNTIME_DIR=/var/lib/termlink
Environment=PROJECT_ROOT=/opt/termlink

ExecStart=/root/.cargo/bin/termlink register \
  --name framework-agent-systemd \
  --identity-key /root/.termlink/identities/framework-agent-systemd.key \
  --roles framework,pickup \
  --tags host=107,project=termlink \
  --cap data_plane,stream \
  --shell \
  --allowed-commands "fw,cat,ls,head,grep,tail,wc,date,python3"

Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/termlink /opt/termlink/.context /opt/termlink/.tasks /tmp

[Install]
WantedBy=multi-user.target
