{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--no-sandbox"]
    },
    "termlink": {
      "command": "termlink",
      "args": ["mcp", "serve"]
    },
    "fw": {
      "command": "python3",
      "args": [".agentic-framework/agents/mcp/framework_mcp_server.py"]
    }
  }
}
